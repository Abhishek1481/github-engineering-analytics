# Copy to .env and fill in. .env is git-ignored - never commit it.

# --- GitHub ------------------------------------------------------------------
# Fine-grained personal access token with read-only "Metadata", "Contents",
# "Pull requests" and "Issues" permissions on the target repositories.
# Optional for public repositories, but unauthenticated access is limited to
# 60 requests/hour (vs 5,000 authenticated).
GITHUB_TOKEN=
# Either list repositories explicitly...
GITHUB_REPOSITORIES=psf/requests
# ...or leave the list empty and discover every repository of an owner:
GITHUB_OWNER=
# org | user
GITHUB_OWNER_TYPE=org
GITHUB_INITIAL_LOOKBACK_DAYS=30
# GITHUB_API_URL=https://github.example.com/api/v3   # GitHub Enterprise Server

# --- PostgreSQL (docker-compose creates it) ----------------------------------
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433
# Used when running gh-analytics from the host (outside Docker):
ANALYTICS_DATABASE_URL=postgresql://analytics:change-me@localhost:5433/github_analytics

# --- Airflow -----------------------------------------------------------------
GITHUB_ANALYTICS_SCHEDULE=@daily

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=text
